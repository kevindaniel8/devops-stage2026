# ------------------------------
# mailcow web ui configuration
# ------------------------------
MAILCOW_HOSTNAME={{ mailcow_hostname }}
MAILCOW_PASS_SCHEME=BLF-CRYPT

# ------------------------------
# SQL database configuration
# ------------------------------
{% if mailcow_db_host %}
DBNAME={{ mailcow_db_name }}
DBUSER={{ mailcow_db_user }}
DBPASS={{ mailcow_db_pass }}
DBROOT={{ mailcow_db_pass }}
SQL_PORT={{ mailcow_db_host }}:{{ mailcow_db_port }}
{% else %}
# Utilisation de la base de données MySQL interne de Mailcow
DBNAME={{ mailcow_db_name }}
DBUSER={{ mailcow_db_user }}
DBPASS={{ mailcow_db_pass }}
DBROOT={{ mailcow_db_pass }}
{% endif %}

# ------------------------------
# Redis configuration
# ------------------------------
REDISPASS={{ mailcow_db_pass }}

# ------------------------------
# HTTP/S Bindings (reverse proxy)
# ------------------------------
# HTTP interne
HTTP_PORT={{ mailcow_http_port }}
HTTP_BIND={{ mailcow_http_bind }}

# HTTPS exposé mais non utilisé (reverse proxy gère TLS)
# Utilisation d'un port différent pour éviter conflit avec reverse-proxy
HTTPS_PORT=8443
HTTPS_BIND={{ mailcow_http_bind }}

# Empêcher Mailcow de gérer les certificats
SKIP_LETS_ENCRYPT=y
HTTP_REDIRECT=n

# ------------------------------
# Other bindings
# ------------------------------
SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995
SIEVE_PORT=4190
DOVEADM_PORT=127.0.0.1:19991
REDIS_PORT=127.0.0.1:7654

TZ={{ mailcow_timezone }}
COMPOSE_PROJECT_NAME=mailcowdockerized
