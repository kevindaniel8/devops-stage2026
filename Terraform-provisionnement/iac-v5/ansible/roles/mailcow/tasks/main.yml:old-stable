- name: Installer dépendances
  apt:
    name:
      - git
    state: present
    update_cache: yes

- name: Supprimer ancien dossier mailcow
  file:
    path: "{{ mailcow_repo_dir }}"
    state: absent

- name: Cloner mailcow-dockerized
  git:
    repo: "https://github.com/mailcow/mailcow-dockerized.git"
    dest: "{{ mailcow_repo_dir }}"
    version: master

- name: Déployer mailcow.conf
  template:
    src: mailcow.conf.j2
    dest: "{{ mailcow_repo_dir }}/mailcow.conf"

- name: Déployer .env
  template:
    src: env.mailcow.j2
    dest: "{{ mailcow_repo_dir }}/.env"

- name: Créer répertoire SSL temporaire
  file:
    path: "{{ mailcow_repo_dir }}/data/assets/ssl"
    state: directory
    mode: '0755'

- name: Générer certificat SSL auto-signé temporaire
  command: openssl req -x509 -nodes -days 365 -newkey rsa:2048 -keyout "{{ mailcow_repo_dir }}/data/assets/ssl/key.pem" -out "{{ mailcow_repo_dir }}/data/assets/ssl/cert.pem" -subj "/C=FR/ST=France/L=Paris/O=Mailcow/CN=mail.greencontracts.lan"
  args:
    creates: "{{ mailcow_repo_dir }}/data/assets/ssl/cert.pem"

- name: Configurer MySQL client pour désactiver SSL
  lineinfile:
    path: "{{ mailcow_repo_dir }}/data/conf/mysql/my.cnf"
    line: "ssl=0"
    insertafter: "[client]"
    create: yes

- name: Démarrer Mailcow
  community.docker.docker_compose_v2:
    project_src: "{{ mailcow_repo_dir }}"
    state: present
    pull: always

- name: Attendre que nginx-mailcow soit démarré
  wait_for:
    timeout: 60
  delegate_to: "{{ inventory_hostname }}"

- name: Corriger configuration nginx pour utiliser port 9000
  command: docker exec mailcowdockerized-nginx-mailcow-1 sed -i 's/:9002/:9000/g' /etc/nginx/includes/sites-default.conf
  delegate_to: "{{ inventory_hostname }}"

- name: Configurer MySQL client dans php-fpm pour désactiver SSL
  command: docker exec mailcowdockerized-php-fpm-mailcow-1 bash -c 'echo "[client]" >> /etc/my.cnf && echo "ssl=0" >> /etc/my.cnf'
  delegate_to: "{{ inventory_hostname }}"

- name: Redémarrer php-fpm pour appliquer la configuration MySQL
  command: docker restart mailcowdockerized-php-fpm-mailcow-1
  delegate_to: "{{ inventory_hostname }}"

- name: Attendre que php-fpm soit prêt
  wait_for:
    timeout: 30
  delegate_to: "{{ inventory_hostname }}"

- name: Redémarrer nginx pour monter les certificats SSL
  command: docker restart mailcowdockerized-nginx-mailcow-1
  delegate_to: "{{ inventory_hostname }}"

- name: Attendre que nginx soit prêt
  wait_for:
    timeout: 30
  delegate_to: "{{ inventory_hostname }}"

- name: Corriger configuration nginx pour utiliser port 9000
  command: docker exec mailcowdockerized-nginx-mailcow-1 sed -i 's/:9002/:9000/g' /etc/nginx/includes/sites-default.conf
  delegate_to: "{{ inventory_hostname }}"

- name: Recharger nginx
  command: docker exec mailcowdockerized-nginx-mailcow-1 nginx -s reload
  delegate_to: "{{ inventory_hostname }}"
