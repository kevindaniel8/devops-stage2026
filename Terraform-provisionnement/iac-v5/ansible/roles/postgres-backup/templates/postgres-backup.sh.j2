#!/bin/bash
# =============================================================================
# PostgreSQL Backup Script
# Generated by Ansible role postgres-backup
# =============================================================================

set -euo pipefail

# Configuration
BACKUP_DIR="{{ postgres_backup_dir }}"
LOG_DIR="{{ postgres_backup_log_dir }}"
RETENTION_DAYS={{ postgres_backup_retention_days }}
BACKUP_FORMAT="{{ postgres_backup_format }}"
COMPRESSION_LEVEL={{ postgres_backup_compression }}

# PostgreSQL connection
PGHOST="{{ postgres_backup_host }}"
PGPORT="{{ postgres_backup_port }}"
PGUSER="{{ postgres_backup_user }}"
{% if postgres_backup_password %}
PGPASSWORD="{{ postgres_backup_password }}"
export PGPASSWORD
{% endif %}

# NAS configuration
NAS_ENABLED="{{ postgres_backup_nas_enabled }}"
NAS_HOST="{{ postgres_backup_nas_host }}"
NAS_USER="{{ postgres_backup_nas_user }}"
NAS_PATH="{{ postgres_backup_nas_path }}"
NAS_SSH_KEY="{{ postgres_backup_nas_ssh_key }}"

# Remote backup configuration
REMOTE_ENABLED="{{ postgres_backup_remote_enabled }}"
REMOTE_HOST="{{ postgres_backup_remote_host }}"
REMOTE_USER="{{ postgres_backup_remote_user }}"
REMOTE_PATH="{{ postgres_backup_remote_path }}"
REMOTE_SSH_KEY="{{ postgres_backup_remote_ssh_key }}"

# Databases to backup
{% if postgres_backup_databases %}
BACKUP_DATABASES="{{ postgres_backup_databases | join(' ') }}"
{% else %}
BACKUP_DATABASES=""
{% endif %}

# Databases to exclude
EXCLUDE_DATABASES="{{ postgres_backup_exclude_databases | join(' ') }}"

# Logging
LOG_FILE="$LOG_DIR/postgres-backup-$(date +%Y%m%d-%H%M%S).log"
mkdir -p "$LOG_DIR"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

log_error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: $*" | tee -a "$LOG_FILE" >&2
}

# Create backup directory
mkdir -p "$BACKUP_DIR"

# Get list of databases to backup
if [ -n "$BACKUP_DATABASES" ]; then
    DATABASES=$BACKUP_DATABASES
else
    DATABASES=$(psql -h "$PGHOST" -p "$PGPORT" -U "$PGUSER" -d postgres -t -c "SELECT datname FROM pg_database WHERE datistemplate = false ORDER BY datname;" 2>> "$LOG_FILE" | tr -d ' ')
fi

# Filter out excluded databases
FILTERED_DBS=""
for db in $DATABASES; do
    if [[ ! " $EXCLUDE_DATABASES " =~ " $db " ]]; then
        FILTERED_DBS="$FILTERED_DBS $db"
    fi
done
DATABASES=$(echo $FILTERED_DBS | xargs)

log "=== PostgreSQL Backup Started ==="
log "Backup directory: $BACKUP_DIR"
log "Databases to backup: $DATABASES"
log "Backup format: $BACKUP_FORMAT"
log "Compression level: $COMPRESSION_LEVEL"

# Backup each database
BACKUP_SUCCESS=0
BACKUP_FAILED=0

for db in $DATABASES; do
    log "Backing up database: $db"
    
    TIMESTAMP=$(date +%Y%m%d-%H%M%S)
    BACKUP_FILE="$BACKUP_DIR/${db}_${TIMESTAMP}.dump"
    
    case $BACKUP_FORMAT in
        custom)
            pg_dump -h "$PGHOST" -p "$PGPORT" -U "$PGUSER" -d "$db" -F c -Z $COMPRESSION_LEVEL -f "$BACKUP_FILE" 2>> "$LOG_FILE"
            ;;
        plain)
            pg_dump -h "$PGHOST" -p "$PGPORT" -U "$PGUSER" -d "$db" -F p > "$BACKUP_FILE" 2>> "$LOG_FILE"
            ;;
        tar)
            pg_dump -h "$PGHOST" -p "$PGPORT" -U "$PGUSER" -d "$db" -F t -Z $COMPRESSION_LEVEL -f "$BACKUP_FILE" 2>> "$LOG_FILE"
            ;;
        directory)
            BACKUP_FILE="$BACKUP_DIR/${db}_${TIMESTAMP}"
            pg_dump -h "$PGHOST" -p "$PGPORT" -U "$PGUSER" -d "$db" -F d -Z $COMPRESSION_LEVEL -f "$BACKUP_FILE" 2>> "$LOG_FILE"
            ;;
        *)
            log_error "Unknown backup format: $BACKUP_FORMAT"
            BACKUP_FAILED=$((BACKUP_FAILED + 1))
            continue
            ;;
    esac
    
    if [ $? -eq 0 ]; then
        FILE_SIZE=$(du -h "$BACKUP_FILE" | cut -f1)
        log "Backup successful: $BACKUP_FILE ($FILE_SIZE)"
        BACKUP_SUCCESS=$((BACKUP_SUCCESS + 1))
    else
        log_error "Backup failed for database: $db"
        BACKUP_FAILED=$((BACKUP_FAILED + 1))
        rm -f "$BACKUP_FILE"
    fi
done

# Copy to NAS
if [ "$NAS_ENABLED" = "true" ]; then
    log "Copying backups to NAS: $NAS_HOST:$NAS_PATH"
    
    # Create remote directory
    ssh -i "$NAS_SSH_KEY" -o StrictHostKeyChecking=no "$NAS_USER@$NAS_HOST" "mkdir -p $NAS_PATH" 2>> "$LOG_FILE"
    
    # Copy backup files
    for db in $DATABASES; do
        LATEST_BACKUP=$(ls -t "$BACKUP_DIR"/${db}_*.dump 2>/dev/null | head -1)
        if [ -n "$LATEST_BACKUP" ]; then
            scp -i "$NAS_SSH_KEY" -o StrictHostKeyChecking=no "$LATEST_BACKUP" "$NAS_USER@$NAS_HOST:$NAS_PATH/" 2>> "$LOG_FILE"
            if [ $? -eq 0 ]; then
                log "Copied to NAS: $(basename $LATEST_BACKUP)"
            else
                log_error "Failed to copy to NAS: $(basename $LATEST_BACKUP)"
            fi
        fi
    done
fi

# Copy to remote host
if [ "$REMOTE_ENABLED" = "true" ] && [ -n "$REMOTE_HOST" ]; then
    log "Copying backups to remote host: $REMOTE_HOST:$REMOTE_PATH"
    
    # Create remote directory
    ssh -i "$REMOTE_SSH_KEY" -o StrictHostKeyChecking=no "$REMOTE_USER@$REMOTE_HOST" "mkdir -p $REMOTE_PATH" 2>> "$LOG_FILE"
    
    # Copy backup files
    for db in $DATABASES; do
        LATEST_BACKUP=$(ls -t "$BACKUP_DIR"/${db}_*.dump 2>/dev/null | head -1)
        if [ -n "$LATEST_BACKUP" ]; then
            scp -i "$REMOTE_SSH_KEY" -o StrictHostKeyChecking=no "$LATEST_BACKUP" "$REMOTE_USER@$REMOTE_HOST:$REMOTE_PATH/" 2>> "$LOG_FILE"
            if [ $? -eq 0 ]; then
                log "Copied to remote: $(basename $LATEST_BACKUP)"
            else
                log_error "Failed to copy to remote: $(basename $LATEST_BACKUP)"
            fi
        fi
    done
fi

# Cleanup old backups
log "Cleaning up old backups (older than $RETENTION_DAYS days)"
find "$BACKUP_DIR" -name "*.dump" -type f -mtime +$RETENTION_DAYS -delete 2>> "$LOG_FILE"
find "$BACKUP_DIR" -name "${db}_*" -type d -mtime +$RETENTION_DAYS -exec rm -rf {} + 2>> "$LOG_FILE" || true

# Cleanup old logs
log "Cleaning up old logs (older than {{ postgres_backup_log_retention_days }} days)"
find "$LOG_DIR" -name "*.log" -type f -mtime +{{ postgres_backup_log_retention_days }} -delete 2>> "$LOG_FILE"

# Summary
log "=== Backup Summary ==="
log "Successful backups: $BACKUP_SUCCESS"
log "Failed backups: $BACKUP_FAILED"
log "Backup directory: $BACKUP_DIR"
log "Log file: $LOG_FILE"

if [ $BACKUP_FAILED -eq 0 ]; then
    log "=== Backup Completed Successfully ==="
    exit 0
else
    log_error "=== Backup Completed with Errors ==="
    exit 1
fi
