$TTL 86400
@   IN  SOA ns.{{ dns_domain }}. admin.{{ dns_domain }}. (
        {{ lookup('pipe', 'date +%Y%m%d%H') }} ; Serial auto-généré
        3600        ; Refresh
        1800        ; Retry
        604800      ; Expire
        86400 )     ; Minimum

@       IN  NS      ns.{{ dns_domain }}.

; Serveur DNS
ns      IN  A       {{ dns_server_ip }}

; Wildcard vers le reverse proxy
*       IN  A       {{ reverse_proxy_ip }}

; Enregistrements générés automatiquement
{% for record in dns_records %}
{{ record.name.split('.')[0] }}   IN  A   {{ record.ip }}
{% endfor %}
