#!/bin/bash
set -e

# Définir les variables avec des valeurs par défaut
DB_HOST="${DB_HOST:-192.168.20.20}"
DB_NAME="${DB_NAME:-modoboa}"
DB_USER="${DB_USER:-modoboa}"
DB_PASSWORD="${DB_PASSWORD:-StrongPassword}"
APP_PORT="${APP_PORT:-8000}"
DJANGO_ALLOWED_HOSTS="${DJANGO_ALLOWED_HOSTS:-mail.greencontracts.lan}"

# Construire l'URL de la base de données
DB_URL="postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}"

# Exporter pour modoboa-admin.py
export DATABASE_URL="$DB_URL"

echo "DATABASE_URL: $DATABASE_URL"
echo "DJANGO_ALLOWED_HOSTS: $DJANGO_ALLOWED_HOSTS"

if [ ! -d /data/instance ]; then
    echo "First run: deploying Modoboa"
    modoboa-admin.py deploy instance --dburl "$DB_URL" --collectstatic --hostname "$DJANGO_ALLOWED_HOSTS"
    mv instance /data/instance
else
    echo "Instance already exists, skipping deploy"
fi

# Modifier ALLOWED_HOSTS dans settings.py
if [ -f /data/instance/settings.py ]; then
    sed -i "s/^ALLOWED_HOSTS = \[\]/ALLOWED_HOSTS = os.environ.get('DJANGO_ALLOWED_HOSTS', '').split(',') if os.environ.get('DJANGO_ALLOWED_HOSTS') else []/" /data/instance/settings.py
    sed -i "1i import os" /data/instance/settings.py
fi

# Démarrer Gunicorn
exec gunicorn instance.wsgi:application --chdir /data/instance --bind 0.0.0.0:${APP_PORT}
