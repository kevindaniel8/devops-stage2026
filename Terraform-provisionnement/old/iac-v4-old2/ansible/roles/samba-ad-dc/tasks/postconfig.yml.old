---
- name: Ensure samba-ad-dc is running
  systemd:
    name: samba-ad-dc
    state: started

- name: Ensure bind9 is running
  systemd:
    name: bind9
    state: started

- name: Clean old docker0 DNS A records (172.17.0.1)
  command: >
    samba-tool dns delete 127.0.0.1 {{ samba_domain | lower }}.org
    {{ item.name }} A 172.17.0.1
    -U administrator%{{ samba_admin_password }}
  loop:
    - { name: "dns-samba-ad" }
    - { name: "@" }
  ignore_errors: yes
  when: not samba_provisioned.stat.exists
