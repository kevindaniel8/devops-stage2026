"""
Configuration Modoboa pour infrastructure avec PostgreSQL 16, LDAP et stockage NFS
"""

import os

# Configuration de base
DEBUG = False
ALLOWED_HOSTS = ['{{ modoboa_domain }}', 'localhost']

# Base de données PostgreSQL 16
DATABASES = {
    'default': {
        'ENGINE': 'django.db.backends.postgresql',
        'NAME': os.environ.get('DATABASE_NAME', '{{ modoboa_db_name }}'),
        'USER': os.environ.get('DATABASE_USER', '{{ modoboa_db_user }}'),
        'PASSWORD': os.environ.get('DATABASE_PASSWORD', '{{ modoboa_db_password }}'),
        'HOST': os.environ.get('DATABASE_HOST', '{{ modoboa_db_host }}'),
        'PORT': os.environ.get('DATABASE_PORT', '{{ modoboa_db_port }}'),
    }
}

# Configuration LDAP
if os.environ.get('LDAP_SERVER'):
    LDAP_AUTH = True
    LDAP_SERVER = os.environ.get('LDAP_SERVER', '{{ modoboa_ldap_server }}')
    LDAP_BIND_DN = os.environ.get('LDAP_BIND_DN', '{{ modoboa_ldap_bind_dn }}')
    LDAP_BIND_PASSWORD = os.environ.get('LDAP_BIND_PASSWORD', '{{ modoboa_ldap_bind_password }}')
    LDAP_BASE_DN = os.environ.get('LDAP_BASE_DN', '{{ modoboa_ldap_base_dn }}')
    LDAP_USER_SEARCH_BASE = os.environ.get('LDAP_USER_SEARCH_BASE', '{{ modoboa_ldap_user_search_base }}')
    LDAP_GROUP_SEARCH_BASE = os.environ.get('LDAP_GROUP_SEARCH_BASE', '{{ modoboa_ldap_group_search_base }}')
    LDAP_USER_OBJECT_CLASS = 'inetOrgPerson'
    LDAP_GROUP_OBJECT_CLASS = 'groupOfNames'
    LDAP_USER_FILTER = '(uid=%(user)s)'
    LDAP_GROUP_FILTER = '(memberUid=%(user)s)'
else:
    LDAP_AUTH = False

# Configuration email
EMAIL_HOST = 'localhost'
EMAIL_PORT = 25
EMAIL_USE_TLS = False
EMAIL_HOST_USER = ''
EMAIL_HOST_PASSWORD = ''
DEFAULT_FROM_EMAIL = os.environ.get('MODoboa_ADMIN_EMAIL', '{{ modoboa_admin_email }}')

# Configuration stockage
MEDIA_ROOT = '/srv/modoboa/instance/media'
STATIC_ROOT = '/srv/modoboa/instance/static'

# Configuration sécurité
SECRET_KEY = os.environ.get('SECRET_KEY', 'change-this-secret-key-in-production')
SECURE_SSL_REDIRECT = {{ 'True' if modoboa_ssl_enabled else 'False' }}
SESSION_COOKIE_SECURE = {{ 'True' if modoboa_ssl_enabled else 'False' }}
CSRF_COOKIE_SECURE = {{ 'True' if modoboa_ssl_enabled else 'False' }}

# Configuration Modoboa
MODoboa_APPS = (
    'modoboa_admin',
    'modoboa_limits',
    'modoboa_parameters',
    'modoboa_pdfcredentials',
    'modoboa_webmail',
)

# Configuration Amavis
AMAVIS_ENABLED = True
AMAVIS_HOST = 'modoboa-amavis'
AMAVIS_PORT = 10024

# Configuration Postfix
POSTFIX_ENABLED = True
POSTFIX_HOST = 'modoboa-postfix'
POSTFIX_PORT = 25

# Configuration Dovecot
DOVECOT_ENABLED = True
DOVECOT_HOST = 'modoboa-dovecot'
DOVECOT_PORT = 143
DOVECOT_SSL_PORT = 993

# Configuration stockage NFS
if os.path.exists('/srv/modoboa/instance/mailboxes'):
    MAILBOX_ROOT = '/srv/modoboa/instance/mailboxes'
if os.path.exists('/srv/modoboa/instance/vmail'):
    VMAIL_ROOT = '/srv/modoboa/instance/vmail'

# Configuration timezone
TIME_ZONE = 'Europe/Paris'
USE_TZ = True

# Configuration langue
LANGUAGE_CODE = 'fr-fr'
USE_I18N = True
USE_L10N = True

# Configuration logging
LOGGING = {
    'version': 1,
    'disable_existing_loggers': False,
    'handlers': {
        'file': {
            'level': 'INFO',
            'class': 'logging.FileHandler',
            'filename': '/srv/modoboa/instance/logs/modoboa.log',
        },
    },
    'loggers': {
        'django': {
            'handlers': ['file'],
            'level': 'INFO',
            'propagate': True,
        },
        'modoboa': {
            'handlers': ['file'],
            'level': 'INFO',
            'propagate': True,
        },
    },
}
