version: '3.8'

services:
  modoboa-web:
    image: {{ modoboa_docker_image }}
    container_name: modoboa-web
    ports:
      - "{{ modoboa_http_port }}:80"
{% if modoboa_ssl_enabled %}
      - "{{ modoboa_https_port }}:443"
{% endif %}
    environment:
      - DATABASE_HOST={{ modoboa_db_host }}
      - DATABASE_PORT={{ modoboa_db_port }}
      - DATABASE_NAME={{ modoboa_db_name }}
      - DATABASE_USER={{ modoboa_db_user }}
      - DATABASE_PASSWORD={{ modoboa_db_password }}
      - MODoboa_ADMIN_EMAIL={{ modoboa_admin_email }}
      - MODoboa_ADMIN_PASSWORD={{ modoboa_admin_password }}
{% if modoboa_ldap_enabled %}
      - LDAP_SERVER={{ modoboa_ldap_server }}
      - LDAP_BIND_DN={{ modoboa_ldap_bind_dn }}
      - LDAP_BIND_PASSWORD={{ modoboa_ldap_bind_password }}
      - LDAP_BASE_DN={{ modoboa_ldap_base_dn }}
      - LDAP_USER_SEARCH_BASE={{ modoboa_ldap_user_search_base }}
      - LDAP_GROUP_SEARCH_BASE={{ modoboa_ldap_group_search_base }}
{% endif %}
    volumes:
      - ./settings.py:/srv/modoboa/instance/settings.py:ro
{% if modoboa_nfs_enabled %}
      - {{ modoboa_nfs_mount_point }}/mailboxes:/srv/modoboa/instance/mailboxes
      - {{ modoboa_nfs_mount_point }}/vmail:/srv/modoboa/instance/vmail
{% endif %}
{% if modoboa_ssl_enabled %}
      - {{ modoboa_ssl_cert_path }}:/etc/ssl/certs/modoboa.crt:ro
      - {{ modoboa_ssl_key_path }}:/etc/ssl/private/modoboa.key:ro
{% endif %}
    networks:
      - {{ modoboa_docker_network }}
    depends_on:
      - modoboa-postfix
      - modoboa-dovecot
      - modoboa-amavis
    restart: unless-stopped

  modoboa-postfix:
    image: {{ modoboa_docker_image_postfix }}
    container_name: modoboa-postfix
    environment:
      - DATABASE_HOST={{ modoboa_db_host }}
      - DATABASE_PORT={{ modoboa_db_port }}
      - DATABASE_NAME={{ modoboa_db_name }}
      - DATABASE_USER={{ modoboa_db_user }}
      - DATABASE_PASSWORD={{ modoboa_db_password }}
    volumes:
{% if modoboa_nfs_enabled %}
      - {{ modoboa_nfs_mount_point }}/mailboxes:/var/mail
      - {{ modoboa_nfs_mount_point }}/vmail:/var/vmail
{% endif %}
    networks:
      - {{ modoboa_docker_network }}
    restart: unless-stopped

  modoboa-dovecot:
    image: {{ modoboa_docker_image_dovecot }}
    container_name: modoboa-dovecot
    environment:
      - DATABASE_HOST={{ modoboa_db_host }}
      - DATABASE_PORT={{ modoboa_db_port }}
      - DATABASE_NAME={{ modoboa_db_name }}
      - DATABASE_USER={{ modoboa_db_user }}
      - DATABASE_PASSWORD={{ modoboa_db_password }}
    volumes:
{% if modoboa_nfs_enabled %}
      - {{ modoboa_nfs_mount_point }}/mailboxes:/var/mail
      - {{ modoboa_nfs_mount_point }}/vmail:/var/vmail
{% endif %}
    networks:
      - {{ modoboa_docker_network }}
    restart: unless-stopped

  modoboa-amavis:
    image: {{ modoboa_docker_image_amavis }}
    container_name: modoboa-amavis
    environment:
      - DATABASE_HOST={{ modoboa_db_host }}
      - DATABASE_PORT={{ modoboa_db_port }}
      - DATABASE_NAME={{ modoboa_db_name }}
      - DATABASE_USER={{ modoboa_db_user }}
      - DATABASE_PASSWORD={{ modoboa_db_password }}
    networks:
      - {{ modoboa_docker_network }}
    restart: unless-stopped

networks:
  {{ modoboa_docker_network }}:
    driver: bridge
