---
# Service Supervisor pour Modoboa
- name: "10 - Configurer Supervisor pour Modoboa"
  ansible.builtin.copy:
    dest: /etc/supervisor/conf.d/modoboa.conf
    content: |
      [program:modoboa]
      command={{ modoboa_venv_dir }}/bin/modoboa-admin.py runserver {{ modoboa_bind_address }}:{{ modoboa_bind_port }}
      directory={{ modoboa_install_dir }}
      autostart=true
      autorestart=true

- name: "11 - Redémarrer Supervisor"
  ansible.builtin.service:
    name: supervisor
    state: restarted
