version: "3.9"

services:
  modoboa:
    build: .
    container_name: modoboa
    restart: unless-stopped

    environment:
      DATABASE_URL: "postgres://{{ modoboa_db_user }}:{{ modoboa_db_password }}@{{ modoboa_db_host }}:{{ modoboa_db_port }}/{{ modoboa_db_name }}"
      DJANGO_ALLOWED_HOSTS: "{{ modoboa_domain }}"
      APP_PORT: "{{ modoboa_app_port }}"

    ports:
      - "{{ modoboa_app_port }}:{{ modoboa_app_port }}"

    volumes:
      - modoboa_data:/data

    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:{{ modoboa_app_port }}/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s

volumes:
  modoboa_data:
    driver: local