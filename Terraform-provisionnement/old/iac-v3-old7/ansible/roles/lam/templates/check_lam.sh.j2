#!/bin/bash
# Script de vérification du service LAM

set -e

# Variables
LAM_PORT="{{ lam_port }}"
LAM_CONTAINER="{{ lam_container_name }}"
POSTGRES_HOST="{{ postgres_host }}"
POSTGRES_PORT="{{ postgres_port }}"
POSTGRES_DB="{{ postgres_db }}"
POSTGRES_USER="{{ postgres_user }}"

# Couleurs pour l'affichage
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Fonction d'affichage
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Vérification du service LAM
echo "=== Vérification LAM - $(date) ==="

# 1. Vérifier si le conteneur est en cours d'exécution
if docker ps --format "table {{.Names}}" | grep -q "^${LAM_CONTAINER}$"; then
    log_info "Conteneur LAM: ACTIF"
    docker ps --filter "name=${LAM_CONTAINER}" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
else
    log_error "Conteneur LAM: INACTIF"
    docker ps -a --filter "name=${LAM_CONTAINER}" --format "table {{.Names}}\t{{.Status}}"
    exit 1
fi

# 2. Vérifier si le service web répond
if curl -f -s "http://localhost:${LAM_PORT}" >/dev/null; then
    log_info "Service web LAM: RÉPONDANT"
else
    log_error "Service web LAM: NON RÉPONDANT"
    curl -v "http://localhost:${LAM_PORT}" 2>&1 | head -10
fi

# 3. Vérifier la connectivité PostgreSQL
if PGPASSWORD="{{ postgres_password }}" psql -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "SELECT 1;" >/dev/null 2>&1; then
    log_info "Connexion PostgreSQL: OPÉRATIONNELLE"
else
    log_error "Connexion PostgreSQL: NON OPÉRATIONNELLE"
fi

# 4. Vérifier les logs du conteneur
echo "Derniers logs du conteneur LAM:"
docker logs "$LAM_CONTAINER" --tail 5 2>/dev/null || log_warn "Impossible d'obtenir les logs"

# 5. Vérifier l'utilisation des ressources
echo "Utilisation des ressources:"
docker stats "$LAM_CONTAINER" --no-stream --format "table {{.Container}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.NetIO}}"

echo "=== Fin de vérification ==="
