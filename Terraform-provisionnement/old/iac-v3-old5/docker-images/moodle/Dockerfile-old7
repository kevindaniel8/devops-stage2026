# ------------------------------------------------
# Moodle 5.2 - PHP 8.3 - Apache
# ------------------------------------------------

FROM php:8.3-apache

# ------------------------------------------------
# Dépendances système
# ------------------------------------------------
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    curl \
    cron \
    postgresql-client \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libzip-dev \
    libicu-dev \
    libpq-dev \
    libxml2-dev \
    libonig-dev \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------
# Extensions PHP requises par Moodle
# ------------------------------------------------
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        gd \
        intl \
        zip \
        soap \
        exif \
        pgsql \
        pdo_pgsql \
        opcache

# ------------------------------------------------
# Redis extension
# ------------------------------------------------
RUN pecl install redis \
    && docker-php-ext-enable redis

# ------------------------------------------------
# Apache modules
# ------------------------------------------------
RUN a2enmod rewrite headers ssl

# ------------------------------------------------
# Moodle 5.2 (stable)
# ------------------------------------------------

# -----------------------------
# Moodle 5.2 (local + fallback)
# -----------------------------

# Copier archive locale si disponible
COPY ressource-local/moodle-latest-502.tgz /tmp/moodle.tgz

RUN set -eux; \
    if [ -f /tmp/moodle.tgz ]; then \
        echo "📦 Utilisation archive locale Moodle"; \
    else \
        echo "🌐 Téléchargement Moodle officiel"; \
        curl -L https://download.moodle.org/download.php/direct/stable502/moodle-latest-502.tgz \
        -o /tmp/moodle.tgz; \
    fi; \
    \
    mkdir -p /var/www; \
    tar -xzf /tmp/moodle.tgz -C /var/www/; \
    rm -f /tmp/moodle.tgz; \
    chown -R www-data:www-data /var/www/moodle

#ENV MOODLE_BRANCH=MOODLE_502_STABLE
#
#RUN git clone --depth=1 --branch ${MOODLE_BRANCH} \
#    https://github.com/moodle/moodle.git /var/www/moodle

# ------------------------------------------------
# Moodledata
# ------------------------------------------------
RUN mkdir -p /var/www/moodledata \
    && chown -R www-data:www-data /var/www/moodle \
    && chown -R www-data:www-data /var/www/moodledata \
    && chmod -R 775 /var/www/moodledata

# ------------------------------------------------
# Apache config
# ------------------------------------------------

COPY docker-images/moodle/moodle.conf /etc/apache2/sites-available/000-default.conf
#COPY moodle.conf /etc/apache2/sites-available/000-default.conf

# ------------------------------------------------
# Entrypoint
# ------------------------------------------------
COPY docker-images/moodle/entrypoint.sh /entrypoint.sh
#COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# ------------------------------------------------
# PHP tuning
# ------------------------------------------------
RUN { \
    echo 'memory_limit=512M'; \
    echo 'upload_max_filesize=128M'; \
    echo 'post_max_size=128M'; \
    echo 'max_execution_time=600'; \
    echo 'max_input_vars=5000'; \
    echo 'opcache.enable=1'; \
    echo 'date.timezone=Europe/Paris'; \
} > /usr/local/etc/php/conf.d/moodle.ini

WORKDIR /var/www/moodle

EXPOSE 80

# ------------------------------------------------
# Healthcheck
# ------------------------------------------------
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=5 \
CMD curl -fsS http://localhost/ || exit 1

ENTRYPOINT ["/entrypoint.sh"]