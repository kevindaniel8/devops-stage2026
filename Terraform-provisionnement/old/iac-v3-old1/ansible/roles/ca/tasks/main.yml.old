---
- name: Créer l’arborescence CA
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - "{{ ca_base_dir }}"
    - "{{ ca_base_dir }}/certs"
    - "{{ ca_base_dir }}/csr"
    - "{{ ca_base_dir }}/private"

# -----------------------------
# 1. Génération de la CA
# -----------------------------

- name: Générer la clé privée de la CA
  openssl_privatekey:
    path: "{{ ca_key_file }}"
    size: 4096
    type: RSA
    mode: '0400'

- name: Générer le CSR de la CA
  openssl_csr:
    path: "{{ ca_csr_file }}"
    privatekey_path: "{{ ca_key_file }}"
    common_name: "MyLocalCA"

- name: Générer le certificat racine de la CA (self-signed)
  openssl_certificate:
    path: "{{ ca_cert_file }}"
    csr_path: "{{ ca_csr_file }}"
    privatekey_path: "{{ ca_key_file }}"
    provider: selfsigned
    selfsigned_not_after: "+3650d"
    selfsigned_digest: sha256
    selfsigned_extensions:
      - "{{ role_path }}/files/ca_ext.cnf"
    mode: '0444'

# -----------------------------
# 2. Certificat serveur signé par la CA
# -----------------------------

- name: Générer la clé privée du serveur
  openssl_privatekey:
    path: "{{ server_key_file }}"
    size: 4096
    type: RSA
    mode: '0400'

- name: Générer la CSR du serveur
  openssl_csr:
    path: "{{ server_csr_file }}"
    privatekey_path: "{{ server_key_file }}"
    common_name: "{{ server_cn }}"

- name: Signer le certificat serveur avec la CA
  openssl_certificate:
    path: "{{ server_cert_file }}"
    csr_path: "{{ server_csr_file }}"
    provider: ownca
    ownca_path: "{{ ca_cert_file }}"
    ownca_privatekey_path: "{{ ca_key_file }}"
    ownca_not_after: "+3650d"
    ownca_digest: sha256
    ownca_extensions:
      - "{{ role_path }}/files/server_ext.cnf"
    mode: '0444'

# -----------------------------
# 3. Generation de la full chain
# -----------------------------

- name: Lire le certificat serveur distant
  slurp:
    src: "{{ server_cert_file }}"
  register: server_cert_content

- name: Lire le certificat CA distant (reverse-proxy nginx)
  slurp:
    src: "{{ ca_cert_file }}"
  register: ca_cert_content

- name: Générer le full chain pour le certificat serveur
  copy:
    dest: "{{ ca_base_dir }}/certs/server-fullchain.crt"
    content: |
      {{ server_cert_content.content | b64decode }}
      {{ ca_cert_content.content | b64decode }}
    mode: '0444'


# -----------------------------
# 4. Verification
# -----------------------------

- name: Vérifier que la CA est valide
  command: "openssl x509 -in {{ ca_cert_file }} -text -noout"
  register: ca_check

- name: Vérifier que CA:TRUE est présent
  assert:
    that:
      - "'CA:TRUE' in ca_check.stdout"
    fail_msg: "La CA générée n'est pas valide (pas CA:TRUE)"


- name: Vérifier que le certificat serveur est signé par la CA
  command: "openssl verify -CAfile {{ ca_cert_file }} {{ server_cert_file }}"
  register: verify_server

- name: Vérifier que le certificat serveur est valide
  assert:
    that:
      - "'OK' in verify_server.stdout"
    fail_msg: "Le certificat serveur n'est pas signé par la CA"
