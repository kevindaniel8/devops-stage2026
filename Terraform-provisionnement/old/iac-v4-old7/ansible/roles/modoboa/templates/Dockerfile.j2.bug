FROM python:3.10-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    libpq-dev \
    libxml2-dev \
    libxslt1-dev \
    libffi-dev \
    libssl-dev \
    librrd-dev \
    rrdtool \
    && apt-get clean

RUN pip install --upgrade pip
RUN pip install modoboa==2.1.1 gunicorn

WORKDIR /data

CMD bash -c " \
    if [ ! -d /data/instance ]; then \
        echo 'First run: deploying Modoboa'; \
        modoboa-admin.py deploy instance \
        --dburl postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}/${DB_NAME}; \
        mv instance /data/instance; \
        sed -i \"s/ALLOWED_HOSTS =.*/ALLOWED_HOSTS = ['${DJANGO_ALLOWED_HOSTS//,/\\',\\'}']/\" /data/instance/instance/settings.py; \
    else \
        echo 'Instance already exists, skipping deploy'; \
    fi && \
    gunicorn instance.wsgi:application --chdir /data/instance --bind 0.0.0.0:${APP_PORT}"