#!/bin/bash
set -euo pipefail

echo "[INFO] Starting Modoboa..."

DB_HOST="${DB_HOST:-192.168.20.20}"
DB_PORT="${DB_PORT:-5432}"
DB_NAME="${DB_NAME:-modoboa}"
DB_USER="${DB_USER:-modoboa}"
DB_PASSWORD="${DB_PASSWORD:-StrongPassword}"
APP_PORT="${APP_PORT:-8000}"
DOMAIN="${DJANGO_ALLOWED_HOSTS:-mail.greencontracts.lan}"

export DATABASE_URL="postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
export DJANGO_ALLOWED_HOSTS="${DOMAIN}"

INSTANCE_DIR="/data/instance"

echo "[INFO] DATABASE_URL=$DATABASE_URL"

# 1 - First deploy ONLY if missing
if [ ! -f "${INSTANCE_DIR}/manage.py" ]; then
    echo "[INFO] First deployment..."

    rm -rf /data/instance || true
    cd /data

    modoboa-admin.py deploy instance \
        --dburl "${DATABASE_URL}" \
        --domain "${DOMAIN}" \
        --collectstatic

    mv instance "${INSTANCE_DIR}"
fi

cd "${INSTANCE_DIR}"

# 2 - FORCE database config sanity check
if [ -f "${INSTANCE_DIR}/settings.py" ] && ! grep -q "default" "${INSTANCE_DIR}/settings.py"; then
    echo "[ERROR] Django database not configured correctly"
    exit 1
fi

# 3 - migrations (only if settings.py exists)
if [ -f "${INSTANCE_DIR}/settings.py" ]; then
    python manage.py migrate --noinput || echo "[WARN] Migrations failed, continuing..."
fi

# 4 - static (only if settings.py exists)
if [ -f "${INSTANCE_DIR}/settings.py" ]; then
    python manage.py collectstatic --noinput || echo "[WARN] Collectstatic failed, continuing..."
fi

# 5 - start
exec gunicorn instance.wsgi:application \
    --chdir "${INSTANCE_DIR}" \
    --bind 0.0.0.0:${APP_PORT}