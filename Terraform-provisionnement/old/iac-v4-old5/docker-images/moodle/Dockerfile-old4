# Moodle Custom Image for K3s
FROM php:8.3-apache

# -----------------------------
# Dependencies
# -----------------------------
RUN apt-get update && apt-get install -y \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libzip-dev \
    libonig-dev \
    libxml2-dev \
    libicu-dev \
    libpq-dev \
    git \
    unzip \
    cron \
    curl \
    postgresql-client \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        gd \
        mysqli \
        pgsql \
        pdo \
        pdo_mysql \
        pdo_pgsql \
        zip \
        intl \
        soap \
        opcache \
        exif \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------
# Redis extension
# -----------------------------
RUN pecl install redis && docker-php-ext-enable redis

# -----------------------------
# Composer
# -----------------------------
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# -----------------------------
# Moodle install
# -----------------------------
ENV MOODLE_VERSION=5.2

RUN mkdir -p /var/www/moodle \
    && git clone --depth 1 --branch MOODLE_502_STABLE https://github.com/moodle/moodle.git /var/www/moodle \
    && cd /var/www/moodle \
    && composer install --no-dev --classmap-authoritative --prefer-dist --no-interaction \
    && mkdir -p /var/www/moodledata \
    && chown -R www-data:www-data /var/www/moodle /var/www/moodledata

# -----------------------------
# Apache config
# -----------------------------
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf \
    && a2enmod rewrite ssl headers

# -----------------------------
# Files
# -----------------------------
COPY moodle.conf /etc/apache2/sites-available/000-default.conf
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# -----------------------------
# PHP tuning
# -----------------------------
RUN { \
    echo 'memory_limit = 512M'; \
    echo 'upload_max_filesize = 128M'; \
    echo 'post_max_size = 128M'; \
    echo 'max_execution_time = 600'; \
    echo 'max_input_vars = 5000'; \
} > /usr/local/etc/php/conf.d/moodle.ini

# -----------------------------
# Workdir
# -----------------------------
WORKDIR /var/www/moodle

# -----------------------------
# Expose
# -----------------------------
EXPOSE 80

# -----------------------------
# Healthcheck
# -----------------------------
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=5 \
    CMD curl -fsS http://localhost:80 > /dev/null || exit 1

# -----------------------------
# Entrypoint
# -----------------------------
ENTRYPOINT ["/entrypoint.sh"]