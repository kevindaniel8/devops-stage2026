---
- name: Télécharger K3s (manager)
  get_url:
    url: "https://github.com/k3s-io/k3s/releases/download/{{ k3s_version }}/k3s"
    dest: /usr/local/bin/k3s
    mode: '0755'

- name: Installer service systemd K3s manager
  template:
    src: k3s-manager.service.j2
    dest: /etc/systemd/system/k3s.service

- name: Activer et démarrer K3s manager
  systemd:
    name: k3s
    enabled: yes
    daemon_reload: yes
    state: restarted

