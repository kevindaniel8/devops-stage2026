apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: moodle
  namespace: {{ moodle_namespace }}
  annotations:
    kubernetes.io/ingress.class: "traefik"
    traefik.ingress.kubernetes.io/router.entrypoints: web
spec:
  rules:
    - host: {{ moodle_hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: moodle
                port:
                  number: {{ moodle_service_port }}
