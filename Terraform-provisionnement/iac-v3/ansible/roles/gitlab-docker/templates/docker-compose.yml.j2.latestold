---
# ma version avec volumes
services:

  gitlab:
    image: gitlab/gitlab-ce:{{ gitlab_version }}
    container_name: gitlab
    restart: unless-stopped
    environment:
      GITLAB_OMNIBUS_CONFIG: |
        external_url 'http://{{ gitlab_hostname }}:{{ gitlab_http_port }}'
        gitlab_rails['gitlab_shell_ssh_port'] = {{ gitlab_ssh_port }}
    ports:
      - "{{ gitlab_http_port }}:80"
      - "{{ gitlab_ssh_port }}:22"
    volumes:
      - ./gitlab/config:/etc/gitlab
      - ./gitlab/logs:/var/log/gitlab
      - ./gitlab/data:/var/opt/gitlab
      #- /usr/local/share/ca-certificates/kevin-ca.crt:/etc/gitlab/trusted-certs/kevin-ca.crt:ro
      - /usr/local/share/ca-certificates/kevin-ca.crt:/usr/local/share/ca-certificates/kevin-ca.crt:ro
    networks:
      - gitlab-network

  gitlab-runner:
    image: gitlab/gitlab-runner:{{ gitlab_runner_version }}
    container_name: gitlab-runner
    restart: unless-stopped
    volumes:
      - ./config/gitlab-runner:/etc/gitlab-runner
      - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - gitlab-network

networks:
  gitlab-network:
    name: gitlab-network

