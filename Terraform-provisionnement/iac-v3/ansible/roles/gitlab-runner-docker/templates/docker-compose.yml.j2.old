version: '3.9'

volumes:
  runner:
    driver: local
  config:
    driver: local

services:
  gitlab-runner:
    restart: unless-stopped
    image: {{ gitlab_runner_image }}
    container_name: gitlab-runner
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - runner:/etc/gitlab-runner
      - config:/etc/gitlab

