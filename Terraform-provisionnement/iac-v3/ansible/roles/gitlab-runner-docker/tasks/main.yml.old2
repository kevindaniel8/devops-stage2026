---
# ============================================================
# 1. Vérifier que Docker est fonctionnel
# ============================================================
- name: 1. Vérifier que Docker est disponible
  command: docker info
  register: docker_check
  changed_when: false
  failed_when: docker_check.rc != 0


# ============================================================
# 2. Créer le dossier du stack GitLab Runner
# ============================================================
- name: 2. Créer le dossier GitLab Runner
  file:
    path: "{{ gitlab_runner_compose_dir }}"
    state: directory
    mode: '0755'


# ============================================================
# 3. Déployer le fichier docker-compose.yml
# ============================================================
- name: 3. Déployer le fichier docker-compose GitLab Runner
  template:
    src: docker-compose.yml.j2
    dest: "{{ gitlab_runner_compose_dir }}/docker-compose.yml"
    mode: '0644'


# ============================================================
# 4. Démarrer / mettre à jour le stack GitLab Runner via docker compose v2
# ============================================================
- name: 4. Démarrer GitLab Runner via docker compose v2
  community.docker.docker_compose_v2:
    project_src: "{{ gitlab_runner_compose_dir }}"
    project_name: "{{ gitlab_runner_project_name }}"
    state: present
    remove_orphans: true


# ============================================================
# 5. Vérifier si le runner est déjà enregistré (flag local)
# ============================================================
- name: 5. Vérifier si le runner est déjà enregistré
  stat:
    path: "{{ gitlab_runner_compose_dir }}/registered.flag"
  register: runner_flag
  when: gitlab_runner_registration_enabled


# ============================================================
# 6. Attendre que le conteneur gitlab-runner soit prêt
#    (important avant l’enregistrement automatique)
# ============================================================
- name: 6. Attendre que le conteneur gitlab-runner soit démarré
  command: docker ps --filter "name=gitlab-runner" --format "{{'{{'}}.Names{{'}}'}}"
  register: runner_container
  retries: 10
  delay: 3
  until: runner_container.stdout == "gitlab-runner"
  changed_when: false
  when: gitlab_runner_registration_enabled


# ============================================================
# 7. Enregistrement automatique du GitLab Runner
# ============================================================
- name: 7. Enregistrer automatiquement le GitLab Runner
  command: >
    docker exec gitlab-runner gitlab-runner register
    --non-interactive
    --url {{ gitlab_runner_url }}
    --registration-token {{ gitlab_runner_registration_token }}
    --executor {{ gitlab_runner_executor }}
    --description "{{ gitlab_runner_description }}"
    --tag-list "{{ gitlab_runner_tags }}"
    --run-untagged="true"
    --locked="false"
  when:
    - gitlab_runner_registration_enabled
    - not runner_flag.stat.exists


# ============================================================
# 8. Créer un flag local pour éviter un double enregistrement
# ============================================================
- name: 8. Créer un flag d’enregistrement
  file:
    path: "{{ gitlab_runner_compose_dir }}/registered.flag"
    state: touch
  when:
    - gitlab_runner_registration_enabled
    - not runner_flag.stat.exists


# ============================================================
# 9. (Optionnel) Debug : afficher l’URL GitLab utilisée
# ============================================================
- name: 9. DEBUG - URL GitLab utilisée
  debug:
    msg: "GitLab Runner URL = {{ gitlab_runner_url }}"
  when: gitlab_runner_registration_enabled
