---
# 1. Vérifier Docker
- name: Vérifier que Docker fonctionne
  command: docker info
  changed_when: false

# 2. Créer le dossier du stack
- name: Créer le dossier GitLab Runner
  file:
    path: "{{ gitlab_runner_compose_dir }}"
    state: directory
    mode: '0755'

# 3. Déployer docker-compose.yml
- name: Déployer docker-compose.yml
  template:
    src: docker-compose.yml.j2
    dest: "{{ gitlab_runner_compose_dir }}/docker-compose.yml"
    mode: '0644'

# 4. Démarrer le stack
- name: Démarrer GitLab Runner
  community.docker.docker_compose_v2:
    project_src: "{{ gitlab_runner_compose_dir }}"
    project_name: "{{ gitlab_runner_project_name }}"
    state: present
    remove_orphans: true

# 5. Attendre que le conteneur soit prêt
- name: Attendre que gitlab-runner soit démarré
  command: docker ps --filter "name=gitlab-runner" --format "{{'{{'}}.Names{{'}}'}}"
  register: runner_container
  retries: 10
  delay: 3
  until: runner_container.stdout == "gitlab-runner"
  changed_when: false

# 6. Inspecter le volume Docker "runner"
- name: Inspecter le volume runner
  command: docker volume inspect runner
  register: runner_volume
  changed_when: false

# 7. Extraire le mountpoint
- set_fact:
    runner_volume_path: "{{ runner_volume.stdout | from_json | first.Mountpoint }}"

# 8. Donner les permissions correctes
- name: Donner les permissions au volume runner
  file:
    path: "{{ runner_volume_path }}"
    owner: 1000
    group: 1000
    recurse: true
