---
# ============================================================
# 0. Paramètres du stack GitLab Runner
# ============================================================

# Répertoire où sera déployé le docker-compose du runner
gitlab_runner_compose_dir: /opt/gitlab-runner

# Nom du projet docker compose
gitlab_runner_project_name: gitlab_runner

# Image GitLab Runner officielle
gitlab_runner_image: gitlab/gitlab-runner:latest


# ============================================================
# 1. Construction automatique de l’URL GitLab
# ============================================================

# 1.1 Protocole (modifiable si ton GitLab est en HTTP)
gitlab_runner_url_scheme: "http"

# 1.2 Host GitLab récupéré automatiquement depuis l’inventaire
#     - Si "gitlab_host" est défini dans host_vars/group_vars → utilisé
#     - Sinon → fallback sur inventory_hostname
gitlab_runner_url_host: "{{ gitlab_host | default(inventory_hostname) }}"

# 1.3 URL GitLab finale construite automatiquement
gitlab_runner_url: "{{ gitlab_runner_url_scheme }}://{{ gitlab_runner_url_host }}"


# ============================================================
# 2. Enregistrement automatique du runner
# ============================================================

# Active/désactive l’enregistrement automatique
gitlab_runner_registration_enabled: false

# Token d’enregistrement GitLab (à personnaliser)
gitlab_runner_registration_token: "xaUtYPdWRXsq5MRR48-K"


# ============================================================
# 3. Paramètres du runner
# ============================================================

gitlab_runner_executor: "docker"
gitlab_runner_description: "docker-runner"
gitlab_runner_tags: "docker"

