{
  "_comment": "Configuration des VMs de la mini-infra Kubernetes",
  "_note": "Ce fichier peut être utilisé par ton script pour générer terraform.tfvars",
  
  "network": {
    "gateway": "192.168.20.1",
    "dns_server": "192.168.20.2",
    "subnet": "192.168.20"
  },

  "vmid_start": 200,

  "vms": [
    {
      "name": "opnsense",
      "ip_suffix": 1,
      "cores": 2,
      "socket": 1,
      "memory": 2048,
      "disk": 10,
      "description": "Firewall / Gateway / Routeur - NAT + filtrage"
    },
    {
      "name": "samba_ad-dns",
      "ip_suffix": 2,
      "cores": 1,
      "socket": 1,
      "memory": 1024,
      "disk": 5,
      "description": "Serveur DNS / Active Directory"
    },
    {
      "name": "db1",
      "ip_suffix": 10,
      "cores": 2,
      "socket": 1,
      "memory": 4096,
      "disk": 20,
      "description": "Base de données interne"
    },
    {
      "name": "db2",
      "ip_suffix": 10,
      "cores": 2,
      "socket": 1,
      "memory": 4096,
      "disk": 20,
      "description": "Base de données interne"
    },
    {
      "name": "cicd-runner",
      "ip_suffix": 50,
      "cores": 4,
      "socket": 1,
      "memory": 4096,
      "disk": 20,
      "description": "Runner CI/CD pour déploiement Kubernetes"
    },
    {
      "name": "loadbalancer",
      "ip_suffix": 100,
      "cores": 2,
      "socket": 1,
      "memory": 2048,
      "disk": 10,
      "description": "Reverse proxy / Load balancer devant Kubernetes"
    },
    {
      "name": "k8s-master",
      "ip_suffix": 110,
      "cores": 2,
      "socket": 1,
      "memory": 4096,
      "disk": 20,
      "description": "Nœud maître du cluster Kubernetes"
    },
    {
      "name": "k8s-worker1",
      "ip_suffix": 111,
      "cores": 2,
      "socket": 1,
      "memory": 4096,
      "disk": 20,
      "description": "Nœud worker Kubernetes #1"
    },
    {
      "name": "k8s-worker2",
      "ip_suffix": 112,
      "cores": 2,
      "socket": 1,
      "memory": 4096,
      "disk": 20,
      "description": "Nœud worker Kubernetes #2"
    }
  ]
}
