Vagrant.configure("2") do |config|
  config.vm.box = "bento/debian-13"

  # Réseau privé
  config.vm.network :private_network, ip: "192.168.56.13"

  # Nom de la VM
  config.vm.hostname = "beszel-vm"

  # Redirection du port Beszel
  config.vm.network "forwarded_port", guest: 8090, host: 8090

  # Provisionnement Docker
  config.vm.provision "shell", path: "provision.sh"

  # Provisionnement Beszel
  config.vm.provision "shell", inline: <<-SHELL
    echo "=== Installation de Beszel ==="

    mkdir -p /opt/beszel
    
    echo "=== Copie du Dockerfile personnalisé ==="
    cp /vagrant/Dockerfile /opt/beszel/Dockerfile
    
    echo "=== Création du docker-compose pour le serveur ==="
    cat <<EOF > /opt/beszel/docker-compose-server.yml
    
services:
  beszel-server:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: beszel-server
    ports:
      - "8090:8090"
    volumes:
      - beszel-data:/data
    environment:
      - BESZEL_PORT=8090
      - SYSTEM_NAME=beszel-Hub
    restart: unless-stopped

volumes:
  beszel-data:

EOF

    echo "=== Création du docker-compose pour l'agent (pré-rempli) ==="
    cat <<EOF > /opt/beszel/docker-compose-agent.yml
services:
  beszel-agent:
    image: henrygd/beszel-agent
    container_name: beszel-agent
    restart: unless-stopped
    privileged: true
    network_mode: host
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /:/host:ro
      - ./beszel_agent_data:/var/lib/beszel-agent
    environment:
      SERVER: "http://127.0.0.1:8090"
      LISTEN: "45876"
      KEY: "VOTRE_KEY_ICI"
      TOKEN: "VOTRE_TOKEN_ICI"
      HUB_URL: "http://127.0.0.1:8090"
EOF

    echo "=== Démarrage de Beszel Hub ==="
    cd /opt/beszel
    docker compose -f docker-compose-server.yml up -d
    
    echo "=== Attente du démarrage de Beszel Hub (2 minutes) ==="
    sleep 120
    
    echo "=== Installation des outils de diagnostic ==="
    docker exec beszel-server sh -c "apk add --no-cache curl bind-tools busybox-extras" 2>/dev/null
    
    echo "=== Beszel Hub prêt ! ==="
    echo "🌐 Accès web : http://192.168.56.13:8090"
    echo "🐚 Accès bash : docker exec -it beszel-server sh"
    echo "🔧 Outils disponibles : curl, nslookup, dig, ping"
  SHELL

  # Ressources
  config.vm.provider "virtualbox" do |vb|
    vb.name = "beszel-vm"
    vb.memory = "1024"
    vb.cpus = 1
  end
end

